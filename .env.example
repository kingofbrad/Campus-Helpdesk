# Copy this file to .env.local and replace the example values.
# Vite does not load this .example file directly; it loads .env.local.
# VITE_ values are exposed in the browser bundle. Never put secrets here.
VITE_ENTRA_CLIENT_ID=your-application-client-id
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common/
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/

# Keep the SPA client ID above separate from this API app registration ID.
VITE_ENTRA_API_SCOPE=api://your-api-application-client-id/access_as_user

# Server-only configuration. Never prefix these values with VITE_.
ENTRA_API_CLIENT_ID=your-api-application-client-id
ENTRA_TENANT_ID=your-entra-tenant-id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
API_PORT=3001

